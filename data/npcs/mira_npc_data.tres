[sub_resource type="Resource" id="DialogueLineData_gift_disliked_1"]
script = ExtResource("2_dialogue_line")
text = "This... I am not very good at handling it. Still, thank you."
expression_id = &"worried"

[sub_resource type="Resource" id="DialogueSequenceData_gift_disliked"]
