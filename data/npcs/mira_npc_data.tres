[sub_resource type="Resource" id="DialogueLineData_first_1"]
script = ExtResource("2_dialogue_line")
text = "请等一下……前面的土还很松。"

[sub_resource type="Resource" id="DialogueLineData_first_2"]
script = ExtResource("2_dialogue_line")
text = "这些幼苗刚移栽不久，根系还没有站稳。"

[sub_resource type="Resource" id="DialogueLineData_first_3"]
script = ExtResource("2_dialogue_line")
text = "我叫米拉，是这里的植物研究员……至少，以前是。"
expression_id = &"worried"

[sub_resource type="Resource" id="DialogueLineData_first_4"]
script = ExtResource("2_dialogue_line")
text = "这座温室已经停用很久了。我现在只照料还能在外面生长的植物。"
expression_id = &"worried"

[sub_resource type="Resource" id="DialogueLineData_first_5"]
script = ExtResource("2_dialogue_line")
text = "你是新来的农场主，对吗？以后经过这里时，请替我留意脚下。"

[sub_resource type="Resource" id="DialogueSequenceData_first_meeting"]
script = ExtResource("3_dialogue_sequence")
sequence_id = &"first_meeting"
lines = Array[ExtResource("2_dialogue_line")]([SubResource("DialogueLineData_first_1"), SubResource("DialogueLineData_first_2"), SubResource("DialogueLineData_first_3"), SubResource("DialogueLineData_first_4"), SubResource("DialogueLineData_first_5")])
one_shot = true

[sub_resource type="Resource" id="DialogueLineData_offer_still_sprouts_1"]
script = ExtResource("2_dialogue_line")
text = "那个……我可以请你帮我确认一件事吗？"

[sub_resource type="Resource" id="DialogueLineData_offer_still_sprouts_2"]
script = ExtResource("2_dialogue_line")
text = "温室外的幼苗能够生长，但我还不能确定这里的土壤是否真的恢复了。"
expression_id = &"worried"

[sub_resource type="Resource" id="DialogueLineData_offer_still_sprouts_3"]
script = ExtResource("2_dialogue_line")
text = "请你收获3份成熟的小麦，带回来的路上也留意一下它们的叶片和根部。"

[sub_resource type="Resource" id="DialogueLineData_offer_still_sprouts_4"]
script = ExtResource("2_dialogue_line")
text = "不需要特意挑最漂亮的。我想看到它们真实生长的样子。"

[sub_resource type="Resource" id="DialogueLineData_offer_still_sprouts_5"]
script = ExtResource("2_dialogue_line")
text = "如果土壤真的没有失去活力……也许，我可以再试一次。"
expression_id = &"worried"

[sub_resource type="Resource" id="DialogueSequenceData_quest_offer_still_sprouts"]
script = ExtResource("3_dialogue_sequence")
sequence_id = &"quest_offer_still_sprouts"
lines = Array[ExtResource("2_dialogue_line")]([SubResource("DialogueLineData_offer_still_sprouts_1"), SubResource("DialogueLineData_offer_still_sprouts_2"), SubResource("DialogueLineData_offer_still_sprouts_3"), SubResource("DialogueLineData_offer_still_sprouts_4"), SubResource("DialogueLineData_offer_still_sprouts_5")])
one_shot = true

[sub_resource type="Resource" id="DialogueLineData_active_still_sprouts_1"]
script = ExtResource("2_dialogue_line")
text = "样本不用着急。植物按照自己的速度生长就好。"

[sub_resource type="Resource" id="DialogueLineData_active_still_sprouts_2"]
script = ExtResource("2_dialogue_line")
text = "等你收获到足够的小麦，再回来找我吧。"

[sub_resource type="Resource" id="DialogueSequenceData_quest_active_still_sprouts"]
script = ExtResource("3_dialogue_sequence")
sequence_id = &"quest_active_still_sprouts"
lines = Array[ExtResource("2_dialogue_line")]([SubResource("DialogueLineData_active_still_sprouts_1"), SubResource("DialogueLineData_active_still_sprouts_2")])

[sub_resource type="Resource" id="DialogueLineData_ready_still_sprouts_1"]
script = ExtResource("2_dialogue_line")
text = "这些就是你收获的样本吗？让我看一下……"
expression_id = &"surprised"

[sub_resource type="Resource" id="DialogueLineData_ready_still_sprouts_2"]
script = ExtResource("2_dialogue_line")
text = "叶片很完整，根部也没有腐坏。它们不是勉强活下来，而是在正常生长。"
expression_id = &"surprised"

[sub_resource type="Resource" id="DialogueLineData_ready_still_sprouts_3"]
script = ExtResource("2_dialogue_line")
text = "原来这里的土壤……真的还有恢复的可能。"
expression_id = &"happy"

[sub_resource type="Resource" id="DialogueLineData_ready_still_sprouts_4"]
script = ExtResource("2_dialogue_line")
text = "谢谢你。我想，我应该重新整理那些旧的研究记录了。"
expression_id = &"happy"

[sub_resource type="Resource" id="DialogueSequenceData_quest_ready_still_sprouts"]
script = ExtResource("3_dialogue_sequence")
sequence_id = &"quest_ready_still_sprouts"
lines = Array[ExtResource("2_dialogue_line")]([SubResource("DialogueLineData_ready_still_sprouts_1"), SubResource("DialogueLineData_ready_still_sprouts_2"), SubResource("DialogueLineData_ready_still_sprouts_3"), SubResource("DialogueLineData_ready_still_sprouts_4")])
one_shot = true

[sub_resource type="Resource" id="DialogueLineData_completed_still_sprouts_1"]
script = ExtResource("2_dialogue_line")
text = "我重新检查了以前留下的土壤记录。"

[sub_resource type="Resource" id="DialogueLineData_completed_still_sprouts_2"]
script = ExtResource("2_dialogue_line")
text = "有些结论或许需要重新验证……不过这一次，我不想再把笔记合上了。"
expression_id = &"happy"

[sub_resource type="Resource" id="DialogueSequenceData_quest_completed_still_sprouts"]
script = ExtResource("3_dialogue_sequence")
sequence_id = &"quest_completed_still_sprouts"
lines = Array[ExtResource("2_dialogue_line")]([SubResource("DialogueLineData_completed_still_sprouts_1"), SubResource("DialogueLineData_completed_still_sprouts_2")])

[sub_resource type="Resource" id="DialogueLineData_repeat_1"]
script = ExtResource("2_dialogue_line")
text = "今天的土壤状态还算稳定。"

[sub_resource type="Resource" id="DialogueLineData_repeat_2"]
script = ExtResource("2_dialogue_line")
text = "谢谢你还记得绕开那些幼苗。"
expression_id = &"happy"

[sub_resource type="Resource" id="DialogueSequenceData_repeat_before_quest"]
script = ExtResource("3_dialogue_sequence")
sequence_id = &"repeat_before_quest"
lines = Array[ExtResource("2_dialogue_line")]([SubResource("DialogueLineData_repeat_1"), SubResource("DialogueLineData_repeat_2")])

[sub_resource type="Resource" id="DialogueLineData_gift_loved_1"]
script = ExtResource("2_dialogue_line")
text = "太好了，你居然记得我喜欢什么。"
expression_id = &"happy"

[sub_resource type="Resource" id="DialogueSequenceData_gift_loved"]
script = ExtResource("3_dialogue_sequence")
sequence_id = &"gift_loved"
lines = Array[ExtResource("2_dialogue_line")]([SubResource("DialogueLineData_gift_loved_1")])

[sub_resource type="Resource" id="DialogueLineData_gift_liked_1"]
script = ExtResource("2_dialogue_line")
text = "谢谢你，这个对我很有用。"
expression_id = &"happy"

[sub_resource type="Resource" id="DialogueSequenceData_gift_liked"]
script = ExtResource("3_dialogue_sequence")
sequence_id = &"gift_liked"
lines = Array[ExtResource("2_dialogue_line")]([SubResource("DialogueLineData_gift_liked_1")])

[sub_resource type="Resource" id="DialogueLineData_gift_neutral_1"]
script = ExtResource("2_dialogue_line")
text = "谢谢你想着我。"

[sub_resource type="Resource" id="DialogueSequenceData_gift_neutral"]
script = ExtResource("3_dialogue_sequence")
sequence_id = &"gift_neutral"
lines = Array[ExtResource("2_dialogue_line")]([SubResource("DialogueLineData_gift_neutral_1")])

[sub_resource type="Resource" id="DialogueLineData_gift_disliked_1"]
script = ExtResource("2_dialogue_line")
text = "这个……我可能不太用得上。不过还是谢谢你。"
expression_id = &"worried"

[sub_resource type="Resource" id="DialogueSequenceData_gift_disliked"]
script = ExtResource("3_dialogue_sequence")
sequence_id = &"gift_disliked"
lines = Array[ExtResource("2_dialogue_line")]([SubResource("DialogueLineData_gift_disliked_1")])

[sub_resource type="Resource" id="DialogueLineData_gift_already_today_1"]
script = ExtResource("2_dialogue_line")
text = "今天你已经送过我礼物了，也给自己留一些吧。"

[sub_resource type="Resource" id="DialogueSequenceData_gift_already_today"]
script = ExtResource("3_dialogue_sequence")
sequence_id = &"gift_already_today"
lines = Array[ExtResource("2_dialogue_line")]([SubResource("DialogueLineData_gift_already_today_1")])

[sub_resource type="Resource" id="DialogueLineData_relationship_daily_1_1"]
script = ExtResource("2_dialogue_line")
text = "你走过来的时候，我又听见土层下面很轻的水声了。"

[sub_resource type="Resource" id="DialogueLineData_relationship_daily_1_2"]
script = ExtResource("2_dialogue_line")
text = "这些声音很细微……以前，我大概会以为是自己听错了。"
expression_id = &"worried"

[sub_resource type="Resource" id="DialogueSequenceData_relationship_daily_1"]
script = ExtResource("3_dialogue_sequence")
sequence_id = &"relationship_daily_1"
lines = Array[ExtResource("2_dialogue_line")]([SubResource("DialogueLineData_relationship_daily_1_1"), SubResource("DialogueLineData_relationship_daily_1_2")])

[sub_resource type="Resource" id="DialogueLineData_relationship_daily_2_1"]
script = ExtResource("2_dialogue_line")
text = "温室关闭之前，旧的排水管也发出过类似的声音。"
expression_id = &"worried"

[sub_resource type="Resource" id="DialogueLineData_relationship_daily_2_2"]
script = ExtResource("2_dialogue_line")
text = "我当时注意到了，却没有停下来仔细确认。现在想想有些可惜。"
expression_id = &"worried"

[sub_resource type="Resource" id="DialogueSequenceData_relationship_daily_2"]
script = ExtResource("3_dialogue_sequence")
sequence_id = &"relationship_daily_2"
lines = Array[ExtResource("2_dialogue_line")]([SubResource("DialogueLineData_relationship_daily_2_1"), SubResource("DialogueLineData_relationship_daily_2_2")])

[sub_resource type="Resource" id="DialogueLineData_relationship_daily_3_1"]
script = ExtResource("2_dialogue_line")
text = "那次事故没有伤到人，可我照料了几个月的幼苗全都没能留下。"
expression_id = &"worried"

[sub_resource type="Resource" id="DialogueLineData_relationship_daily_3_2"]
script = ExtResource("2_dialogue_line")
text = "大家都说，是旧管道老化才是主要原因。"

[sub_resource type="Resource" id="DialogueLineData_relationship_daily_3_3"]
script = ExtResource("2_dialogue_line")
text = "可我一直觉得，是不是自己哪里判断错了，为此犹豫了很久。"
expression_id = &"worried"

[sub_resource type="Resource" id="DialogueSequenceData_relationship_daily_3"]
script = ExtResource("3_dialogue_sequence")
sequence_id = &"relationship_daily_3"
lines = Array[ExtResource("2_dialogue_line")]([SubResource("DialogueLineData_relationship_daily_3_1"), SubResource("DialogueLineData_relationship_daily_3_2"), SubResource("DialogueLineData_relationship_daily_3_3")])

[sub_resource type="Resource" id="DialogueLineData_relationship_daily_4_1"]
script = ExtResource("2_dialogue_line")
text = "后来我常想，如果当时更相信自己的判断，结果会不会不一样。"
expression_id = &"worried"

[sub_resource type="Resource" id="DialogueLineData_relationship_daily_4_2"]
script = ExtResource("2_dialogue_line")
text = "但你让我明白，照料植物这件事，并不是一次失误就永远做不好。"

[sub_resource type="Resource" id="DialogueLineData_relationship_daily_4_3"]
script = ExtResource("2_dialogue_line")
text = "真正重要的，是在变化发生之后，仍然愿意继续回应它们。"
expression_id = &"happy"

[sub_resource type="Resource" id="DialogueSequenceData_relationship_daily_4"]
script = ExtResource("3_dialogue_sequence")
sequence_id = &"relationship_daily_4"
lines = Array[ExtResource("2_dialogue_line")]([SubResource("DialogueLineData_relationship_daily_4_1"), SubResource("DialogueLineData_relationship_daily_4_2"), SubResource("DialogueLineData_relationship_daily_4_3")])

[sub_resource type="Resource" id="DialogueLineData_relationship_daily_5_1"]
script = ExtResource("2_dialogue_line")
text = "最近，我又能安心听着温室下面的水流声了。"

[sub_resource type="Resource" id="DialogueLineData_relationship_daily_5_2"]
script = ExtResource("2_dialogue_line")
text = "这一次它听起来不像警报，更像有什么正在慢慢苏醒。"
expression_id = &"happy"

[sub_resource type="Resource" id="DialogueLineData_relationship_daily_5_3"]
script = ExtResource("2_dialogue_line")
text = "等我们把那里重新整理好，我想请你一起看第一株重新开花的植物。"
expression_id = &"happy"

[sub_resource type="Resource" id="DialogueSequenceData_relationship_daily_5"]
script = ExtResource("3_dialogue_sequence")
sequence_id = &"relationship_daily_5"
lines = Array[ExtResource("2_dialogue_line")]([SubResource("DialogueLineData_relationship_daily_5_1"), SubResource("DialogueLineData_relationship_daily_5_2"), SubResource("DialogueLineData_relationship_daily_5_3")])

