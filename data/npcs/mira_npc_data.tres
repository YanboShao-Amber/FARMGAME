[sub_resource type="Resource" id="DialogueLineData_gift_liked_1"]
script = ExtResource("2_dialogue_line")
text = "Thank you. It looks well kept. I will take good care of it."
expression_id = &"happy"

[sub_resource type="Resource" id="DialogueSequenceData_gift_liked"]
