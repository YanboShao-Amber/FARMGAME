[sub_resource type="Resource" id="DialogueLineData_gift_neutral_1"]
script = ExtResource("2_dialogue_line")
text = "Thank you. I will put it somewhere suitable."

[sub_resource type="Resource" id="DialogueSequenceData_gift_neutral"]
script = ExtResource("3_dialogue_sequence")
