[resource]
script = ExtResource("1_npc_data")
npc_id = &"mira"
display_name_cn = "米萝"
display_name_en = "Mira"
occupation_cn = "植物研究员"
occupation_en = "Plant Researcher"
short_description_cn = "负责照料废弃温室周围植物的年轻白兔研究员。性格温柔安静，对植物极有耐心，却因过去的一次实验失败而不敢重新开始。"
short_description_en = "A gentle and quiet young rabbit researcher who cares for the plants around the abandoned greenhouse. She is deeply patient with plants, but a past experiment failure has made her afraid to begin again."
portrait_neutral = ExtResource("4_portrait_neutral")
portrait_happy = ExtResource("5_portrait_happy")
portrait_worried = ExtResource("6_portrait_worried")
portrait_surprised = ExtResource("7_portrait_surprised")
dialogue_sequences = Array[ExtResource("3_dialogue_sequence")]([SubResource("DialogueSequenceData_first_meeting"), SubResource("DialogueSequenceData_quest_offer_still_sprouts"), SubResource("DialogueSequenceData_quest_active_still_sprouts"), SubResource("DialogueSequenceData_quest_ready_still_sprouts"), SubResource("DialogueSequenceData_quest_completed_still_sprouts"), SubResource("DialogueSequenceData_repeat_before_quest"), SubResource("DialogueSequenceData_gift_loved"), SubResource("DialogueSequenceData_gift_liked"), SubResource("DialogueSequenceData_gift_neutral"), SubResource("DialogueSequenceData_gift_disliked"), SubResource("DialogueSequenceData_gift_already_today"), SubResource("DialogueSequenceData_relationship_daily_1"), SubResource("DialogueSequenceData_relationship_daily_2"), SubResource("DialogueSequenceData_relationship_daily_3"), SubResource("DialogueSequenceData_relationship_daily_4"), SubResource("DialogueSequenceData_relationship_daily_5")])
relationship_dialogue_tiers = Array[ExtResource("12_relationship_tier")]([SubResource("RelationshipDialogueTierData_0"), SubResource("RelationshipDialogueTierData_1"), SubResource("RelationshipDialogueTierData_2"), SubResource("RelationshipDialogueTierData_3"), SubResource("RelationshipDialogueTierData_4"), SubResource("RelationshipDialogueTierData_5")])
quests = Array[ExtResource("8_quest_data")]([ExtResource("9_mira_still_sprouts_quest")])
relationship_profile = ExtResource("10_mira_relationship")
gift_preferences = ExtResource("11_mira_gift_preferences")
greenhouse_profile = ExtResource("13_mira_greenhouse")
